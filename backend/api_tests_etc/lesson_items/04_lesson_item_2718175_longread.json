          "type": "image",
          "label": "Изображение",
          "title": "",
          "images": [
            {
              "id": 3455,
              "url": "https://u.netology.ru/backend/uploads/lms/assets/2025/3/3455/file/91010345-574d-41ee-b03a-0f52bb4caac5.png"
            }
          ],
          "settings": {
