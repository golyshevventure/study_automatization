          "images": [
            {
              "id": 11365,
              "url": "https://u.netology.ru/backend/uploads/lms/assets/2026/4/11365/file/184ed058-c3ce-4a95-ac4e-852ed16f3f3d.jpg"
            },
            {
              "id": 11366,
              "url": "https://u.netology.ru/backend/uploads/lms/assets/2026/4/11366/file/4c2ca661-933e-44c5-81b8-f5e6c97850d6.jpg"
            }
          ],
          "settings": {
            "width": 100,
