            "indent": 32
          }
        },
        {
          "id": "56d3ab0d-7618-4f82-81b6-f3e9ce48565b",
          "type": "text",
          "label": "Текст",
          "value": "<h2>Навигация по сообществу</h2>",
          "settings": {
